config_version: 0
gateway:
  files_base_dir: "/tmp/clawp"
  openrouter:
    # api_key: "" # Provided by CLAWP_OPENROUTER_API_KEY environment variable.
    model: "stepfun/step-3.5-flash:free"
  matrix:
    homeserver: "https://matrix.org"
    username: "@your-user:matrix.org"
    # password: "" # Provided by CLAWP_MATRIX_PASSWORD environment variable.
    device_id: "clawp"
  api:
    host: "0.0.0.0"
    port: 8000
    log_level: "info"
